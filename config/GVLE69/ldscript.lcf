MEMORY
{
    text : origin = $ORIGIN
}

SECTIONS
{
    GROUP:
    {
        $SECTIONS
        .stack ALIGN(0x100):{}
    } > text

    /* The original's stack and arena bounds, derived from the layout so they
       follow .sdata2 when the sections change size. __OSThreadInit loads
       _stack_end (0x806709A0 in the original), 0x20 past the end of .sdata2
       (presumably an .sbss2 that never reaches the DOL), and OSInit loads
       __ArenaLo (0x806809C0), 0x20 above the stack top rather than above a
       0x2000-byte debugger stack. A fixed _stack_end lets .sdata2 grow into
       the stack: __OSThreadInit writes its 0xDEADBABE guard there and
       OSClearStack zeroes the rest. */
    _stack_end = ADDR(.sdata2) + SIZEOF(.sdata2) + 0x20;
    _stack_addr = (_stack_end + $STACKSIZE + 0x7) & ~0x7;
    _db_stack_addr = (_stack_addr + 0x2000);
    _db_stack_end = _stack_addr;
    __ArenaLo = _stack_addr + 0x20;
    __ArenaHi = $ARENAHI;

    /* crt0 (__start) clears .sbss up to lbl_8066FB50 (0x8066FB50 in the
       original), the end of .sbss, which falls in the padding gap before
       .sdata2 and so maps to no section (the deeper root of the issue-1 crash).
       dtk emits it as an undefined absolute reference; define it here from the
       section so the clear still covers all of .sbss when .sbss changes size. */
    lbl_8066FB50 = ADDR(.sbss) + SIZEOF(.sbss);

    /* Pin the vestigial _SDA2_BASE_ so crt0's r2 setup matches the original.
       See docs/baseline.md (Small-data). */
    _SDA2_BASE_ = 0x806834E0;
}

FORCEACTIVE
{
    $FORCEACTIVE
}
